# =============================================================================
# Diary Agency — cấu hình Apache cho Hostinger Shared Hosting
# File này được copy sang thư mục `out/` khi build và cần nằm cùng cấp với
# index.html trong public_html.
# =============================================================================

# --- Nén nội dung trước khi truyền ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --- Bộ nhớ đệm trình duyệt ---
<IfModule mod_expires.c>
  ExpiresActive On

  # Tài nguyên có vân tay trong tên file (JS/CSS do Next sinh ra) — đệm dài
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"

  # Hình ảnh
  ExpiresByType image/webp              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/svg+xml           "access plus 6 months"

  # HTML luôn kiểm tra lại để deploy mới hiện ngay
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Header bảo mật cơ bản ---
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Kiểu MIME cho WebP (một số cấu hình Apache cũ còn thiếu) ---
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# --- Định tuyến ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ép HTTPS (bỏ comment sau khi đã cài SSL trên Hostinger)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Bỏ www (bỏ comment nếu muốn dùng tên miền không có www)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Next.js xuất tĩnh với trailingSlash → /giai-phap/ ứng với /giai-phap/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

# --- Trang 404 tuỳ chỉnh do Next sinh ra ---
ErrorDocument 404 /404.html

# --- Chặn truy cập file nhạy cảm ---
<FilesMatch "^\.env|\.git">
  Require all denied
</FilesMatch>
