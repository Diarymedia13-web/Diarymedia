# =============================================================================
# Biến môi trường — copy file này thành `.env.local` khi chạy máy local,
# và khai báo trong GitHub Secrets khi deploy tự động.
# =============================================================================

# Access key của Web3Forms — dùng cho form yêu cầu tư vấn ở trang /lien-he.
# Lấy miễn phí tại https://web3forms.com (nhập email nhận thư, key gửi về hộp thư).
# Chưa điền thì form vẫn hiển thị nhưng sẽ hướng khách gọi hotline / gửi email.
NEXT_PUBLIC_WEB3FORMS_KEY=

# URL của Cloudflare Worker proxy cho trợ lý AI chat (xem thư mục worker/).
# Deploy worker bằng `npx wrangler deploy` trong worker/, dán URL nhận được vào đây.
# Chưa điền thì widget chat sẽ không hiển thị trên site — không ảnh hưởng gì khác.
NEXT_PUBLIC_CHAT_WORKER_URL=

# Khóa API Anthropic — dùng cho Diary Business Agent tại /agent.
# Lấy tại https://console.anthropic.com → Settings → API Keys.
# KHÔNG có tiền tố NEXT_PUBLIC_, nên Next.js không nhúng khóa này vào bundle
# trình duyệt. Chỉ tiến trình server đọc được, qua route /api/agent.
# Chưa điền thì trang /agent vẫn mở được nhưng sẽ báo lỗi thiếu cấu hình.
ANTHROPIC_API_KEY=your_api_key_here
