# =============================================================================
# Biến môi trường — copy file này thành `.env.local` khi chạy máy local,
# và khai báo trong GitHub Secrets khi deploy tự động.
# =============================================================================

# Access key của Web3Forms — dùng cho form yêu cầu tư vấn ở trang /lien-he.
# Lấy miễn phí tại https://web3forms.com (nhập email nhận thư, key gửi về hộp thư).
# Chưa điền thì form vẫn hiển thị nhưng sẽ hướng khách gọi hotline / gửi email.
NEXT_PUBLIC_WEB3FORMS_KEY=
